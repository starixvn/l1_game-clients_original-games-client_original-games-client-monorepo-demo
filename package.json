{
    "name": "original-games-client-html",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "generate-tolgee-data": "npx ts-node --project tsconfig.node.json ./packages/shared/src/tolgee-generator.ts",
        "dev:sedie-multiplayer": "npm run -w @games/sedie-multiplayer dev:standalone",
        "build": "npm run build:all",
        "build:all": "npm run -w @shared/merged build && npm run -w @games/sedie-multiplayer build:standalone",
        "start": "npm run -w @games/sedie-multiplayer start:standalone",
        "lint": "npm run -w @games/sedie-multiplayer lint",
        "test": "npm run -w @games/sedie-multiplayer test",
        "test:watch": "npm run -w @games/sedie-multiplayer test:watch",
        "test:coverage": "npm run -w @games/sedie-multiplayer test:coverage",
        "clean": "npm run -w @shared/merged clean && npm run -w @games/sedie-multiplayer clean",
        "clean:all": "npm run clean",
        "run-code-and-sonar-local": "node sonar-scripts/run-code-and-sonar-local.js",
        "run-code-and-sonar-server": "node sonar-scripts/run-code-and-sonar.js",
        "fix-and-verify-sonar": "node sonar-scripts/fix-and-verify.js",
        "run-code-and-sonar-changed": "node sonar-scripts/run-code-and-sonar-changed.js"
    },
    "export-sonar-report": "node sonar-scripts/export-sonar-issues.js",
    "devDependencies": {
        "@commitlint/cli": "^18.4.4",
        "@commitlint/config-conventional": "^18.4.4",
        "husky": "^8.0.3",
        "concurrently": "^9.0.1",
        "cross-env": "^7.0.3"
    }
}