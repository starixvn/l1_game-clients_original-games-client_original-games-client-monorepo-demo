{
    "compilerOptions": {
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "types": [
            "node",
            "jest"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@sedie": [
                "packages/sedie/src"
            ],
            "@sedie/*": [
                "packages/sedie/src/*",
                "src/games/sedie-multiplayer/*"
            ],
            "@baccarat": [
                "packages/baccarat/src"
            ],
            "@baccarat/*": [
                "packages/baccarat/src/*"
            ],
            "@shared/*": [
                "packages/shared/src/*"
            ],
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "jest.config.ts",
        "packages/sedie/src/**/*",
        "packages/baccarat/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "packages/sedie/dist",
        "packages/shared/dist"
    ]
}