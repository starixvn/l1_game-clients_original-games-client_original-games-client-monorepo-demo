{
    "name": "@games/baccarat",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "obfuscator-config-file": "node ./configs/config-obfuscator.js",
        "build": "node -e \"console.log('Skipping baccarat package build (using app sources)')\"",
        "clean": "rimraf dist",
        "dev:standalone": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=10 FAST_REFRESH=false next dev -p 3002",
        "build:standalone": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=10 next build",
        "start:standalone": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=10 next start -p 3002"
    },
    "dependencies": {
        "@sentry/nextjs": "^9.41.0",
        "@tolgee/format-icu": "^5.28.6",
        "@tolgee/react": "^5.28.6",
        "@use-gesture/react": "^10.3.1",
        "axios": "^1.8.2",
        "base64-string": "^1.1.2",
        "classnames": "^2.3.2",
        "cross-env": "^7.0.3",
        "next": "14.2.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "@next/bundle-analyzer": "^14.2.31"
