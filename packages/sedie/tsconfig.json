{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shared/*": [
        "../shared/src/*"
      ],
      "@sedie/*": [
        "src/*"
      ],
      "@baccarat/*": [
        "../baccarat/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "src/**/*",
    "next.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}